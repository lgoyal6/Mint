# Mint environment. Copy to .env and fill in. Kept in sync with src/mint/backend/settings.py.

# --- API keys (existing event pipeline uses Apollo/Exa; AgentBox Source safely dry-runs without either key) ---
APOLLO_API_KEY=
EXA_API_KEY=
GMI_API_KEY=
LUMA_API_KEY=
HUBSPOT_ACCESS_TOKEN=
CLAY_WEBHOOK_URL=
CLAY_CALLBACK_TOKEN=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mint
MINT_TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mint_test

# --- Models (all served through GMI Cloud MaaS) ---
GMI_BASE_URL=https://api.gmi-serving.com
GMI_API_FORMAT=anthropic
GMI_CLASSIFIER_MODEL=anthropic/claude-haiku-4.5
GMI_AGENT_MODEL=anthropic/claude-sonnet-4-6
GMI_REVIEWER_MODEL=anthropic/claude-opus-4.5

# --- Ops / scheduled sync (token guards POST /admin/sync-luma and /admin/auto-review) ---
MINT_SYNC_TOKEN=

# --- Auth + session (production) ---
MINT_AUTH_ENABLED=false
MINT_AUTH_PASSWORD=
MINT_SESSION_SECRET=
MINT_SESSION_COOKIE_NAME=mint_session
MINT_SESSION_MAX_AGE_SECONDS=604800
MINT_COOKIE_SECURE=true
MINT_COOKIE_SAMESITE=none
MINT_FRONTEND_ORIGIN=http://localhost:3000

# --- Rubric / config file paths (defaults are fine for local) ---
ICP_CONFIG_PATH=config/icp.yaml
COMPETITOR_TERMS_PATH=config/competitor_terms.txt
BIGTECH_TERMS_PATH=config/bigtech_terms.txt

# --- Vendor endpoints + Exa rate limiting (defaults are fine; override only if needed) ---
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_CREDIT_COST_USD=
EXA_BASE_URL=https://api.exa.ai
HUBSPOT_BASE_URL=https://api.hubapi.com
EXA_RATE_LIMIT_PER_SECOND=1.5
EXA_RATE_LIMIT_BURST=10

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
